<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Dice game' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Pirata+One&family=MedievalSharp&display=swap" rel="stylesheet">
    <% if (user) { %>
        <script src="/js/invitations.js" defer></script>
    <% } %>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-logo">
                <a href="/">🎲 Dice Game</a>
            </div>
            <ul class="nav-menu">
                <li><a href="/">Domů</a></li>
                <% if (user) { %>
                <li><a href="/friends">Přátelé</a></li>
                <li style="position: relative;">
                    <a href="#" onclick="toggleInvitations(event)" style="display:flex; align-items:center;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ecf0f1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        <span id="inv-badge" style="display:none; position:absolute; top:2px; right:2px; background:#7f3004; color:white; border-radius:50%; width:16px; height:16px; font-size:10px; align-items:center; justify-content:center;">0</span>
                    </a>
                    <div id="inv-dropdown" style="display:none; position:absolute; right:0; top:40px; background:white; border:2px solid #c8bdb0; min-width:280px; z-index:999; box-shadow: 2px 2px 8px rgba(0,0,0,0.15);">
                        <div style="padding:0.75rem 1rem; border-bottom:1px solid #e8ddd0; font-weight:bold; color:#7f3004;">
                            Pozvánky ke hře
                        </div>
                        <div id="inv-list" style="max-height:300px; overflow-y:auto;">
                            <p style="padding:1rem; color:#7a665d; font-size:0.9rem;">Žádné pozvánky</p>
                        </div>
                    </div>
                </li>
                <% } %>
                <li><a href="/matchmaking">Matchmaking</a></li>
                <li><a href="/stats">Statistiky</a></li>
                <li><a href="/kostky/index.html">Kostky</a></li>
                <% if (user) { %>
                <li>
                    <form method="post" action="/auth/logout" style="margin: 0; padding: 0; display: flex; align-items: center;">
                        <button type="submit" style="all: unset; cursor: pointer; color: #ecf0f1; font-size: 20px; padding: 10px; transition: color 0.3s;">Odhlásit</button>
                    </form>
                </li>
                <% } else { %>
                    <li><a href="/auth/login">Přihlásit se</a></li>
                    <li><a href="/auth/register">Registrace</a></li>
                <% } %>
            </ul>
        </div>
    </nav>