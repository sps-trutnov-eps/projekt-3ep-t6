<%- include('../partials/header') %>

<div class="container">
    <div class="game-wrapper">
        <h1>Globální statistiky</h1>

        <div class="game-board" style="margin-top: 1rem;">
            <h2>Nejlepší hráči</h2>
            <div class="stats-table">
                <div class="stats-header">
                    <span class="stats-rank">#</span>
                    <span class="stats-name">Hráč</span>
                    <span class="stats-wins">Výhry</span>
                    <span class="stats-losses">Prohry</span>
                    <span class="stats-ratio">W/L</span>
                    <span class="stats-streak">Série</span>
                </div>
                <% players.forEach((player, index) => { %>
                <div class="stats-row <%= index === 0 ? 'stats-gold' : index === 1 ? 'stats-silver' : index === 2 ? 'stats-bronze' : '' %>">
                    <span class="stats-rank"><%= index + 1 %>.</span>
                    <span class="stats-name"><%= player.username %></span>
                    <span class="stats-wins"><%= player.wins %></span>
                    <span class="stats-losses"><%= player.losses %></span>
                    <span class="stats-ratio"><%= player.wl_ratio ? player.wl_ratio.toFixed(2) : '-' %></span>
                    <span class="stats-streak"><%= player.win_streak %></span>
                </div>
                <% }) %>
            </div>
        </div>

    </div>
</div>

<%- include('../partials/footer') %>