<%- include('../partials/header') %>

<div class="container">
    <div class="lobby-wrapper">
        <h1>Multiplayer Lobby</h1>
        <p class="subtitle">Jak chceš hrát?</p>

        <div class="lobby-options">

            <div class="lobby-card">
                <div class="lobby-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#667889" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </div>
                <h2>Vytvořit místnost</h2>
                <p>Vytvoř privátní místnost a pozvi přátele pomocí kódu</p>
                <button class="btn-primary" onclick="showPanel('create')">Vytvořit</button>
            </div>

            <div class="lobby-card">
                <div class="lobby-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#667889" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="7.5" cy="15.5" r="5.5"/>
                        <path d="M21 2l-9.6 9.6M15.5 7.5l3 3"/>
                    </svg>
                </div>
                <h2>Připojit se kódem</h2>
                <p>Zadej kód místnosti, který ti poslal kamarád</p>
                <button class="btn-primary" onclick="showPanel('join')">Připojit se</button>
            </div>

            <div class="lobby-card">
                <div class="lobby-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#667889" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="3"/>
                        <circle cx="8" cy="8" r="1.2" fill="#667889"/>
                        <circle cx="16" cy="8" r="1.2" fill="#667889"/>
                        <circle cx="8" cy="16" r="1.2" fill="#667889"/>
                        <circle cx="16" cy="16" r="1.2" fill="#667889"/>
                        <circle cx="12" cy="12" r="1.2" fill="#667889"/>
                    </svg>
                </div>
                <h2>Náhodná hra</h2>
                <p>Připoj se do veřejné místnosti s náhodným hráčem</p>
                <button class="btn-secondary" onclick="findPublicRoom()">Hledat hru</button>
            </div>

        </div>

        <!-- Vytvorit mistnost -->
        <div id="panel-create" class="lobby-panel" style="display:none;">
            <div class="panel-header">
                <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2c3e50" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Nová místnost
                </h3>
                <button class="btn-close" onclick="closePanel()" title="Zavřít">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="panel-body">
                <div id="create-result" style="display:none;">
                    <p class="panel-label">Kód místnosti:</p>
                    <div class="room-code-display">
                        <span id="room-code-text">——</span>
                        <button class="btn-copy" onclick="copyCode()" title="Kopírovat">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#667889" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="9" y="9" width="13" height="13" rx="2"/>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                            </svg>
                        </button>
                    </div>
                    <p class="panel-hint">Pošli tento kód kamarádům, ať se připojí.</p>

                    <label class="toggle-label">
                        <input type="checkbox" id="toggle-public" onchange="toggleVisibility()">
                        <span class="toggle-slider"></span>
                        Veřejná místnost
                    </label>
                    <p class="panel-hint">Místnost je <strong id="visibility-status">privátní</strong> – vidí ji jen lidé s kódem.</p>

                    <button class="btn-primary" style="margin-top:1rem; width:100%;" onclick="alert('Spuštění hry – zatím není implementováno')">
                        Spustit hru
                    </button>
                </div>

                <div id="create-loading" style="display:none; text-align:center;">
                    <p>Vytvářím místnost…</p>
                </div>

                <button class="btn-primary" id="btn-do-create" onclick="createRoom()" style="width:100%;">
                    Vytvořit místnost
                </button>
            </div>
        </div>

        <!-- Pripojit se kodem -->
        <div id="panel-join" class="lobby-panel" style="display:none;">
            <div class="panel-header">
                <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2c3e50" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                        <circle cx="7.5" cy="15.5" r="5.5"/>
                        <path d="M21 2l-9.6 9.6M15.5 7.5l3 3"/>
                    </svg>
                    Připojit se
                </h3>
                <button class="btn-close" onclick="closePanel()" title="Zavřít">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="panel-body">
                <label class="panel-label" for="join-code-input">Zadej kód místnosti</label>
                <input
                    type="text"
                    id="join-code-input"
                    class="code-input"
                    placeholder="např. ABC123"
                    maxlength="8"
                    oninput="this.value = this.value.toUpperCase()"
                    onkeydown="if(event.key==='Enter') joinRoom()"
                />
                <p id="join-error" class="panel-error" style="display:none;">Místnost nenalezena nebo je plná.</p>
                <button class="btn-primary" style="margin-top:1rem; width:100%;" onclick="joinRoom()">
                    Připojit se
                </button>
            </div>
        </div>

        <!-- Nahodna hra -->
        <div id="panel-random" class="lobby-panel" style="display:none;">
            <div class="panel-header">
                <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2c3e50" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle; margin-right:6px;">
                        <rect x="2" y="2" width="20" height="20" rx="3"/>
                        <circle cx="8" cy="8" r="1.2" fill="#2c3e50"/>
                        <circle cx="16" cy="8" r="1.2" fill="#2c3e50"/>
                        <circle cx="8" cy="16" r="1.2" fill="#2c3e50"/>
                        <circle cx="16" cy="16" r="1.2" fill="#2c3e50"/>
                        <circle cx="12" cy="12" r="1.2" fill="#2c3e50"/>
                    </svg>
                    Náhodná hra
                </h3>
                <button class="btn-close" onclick="closePanel()" title="Zavřít">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="panel-body" style="text-align:center;">
                <p>Hledám dostupnou veřejnou místnost…</p>
                <button class="btn-secondary" style="margin-top:1rem;" onclick="closePanel()">Zrušit</button>
            </div>
        </div>

    </div>
</div>

<script>
    function showPanel(type) {
        closePanel(false);
        const el = document.getElementById('panel-' + type);
        if (el) {
            el.style.display = 'block';
            el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function closePanel(reset = true) {
        ['create', 'join', 'random'].forEach(t => {
            const el = document.getElementById('panel-' + t);
            if (el) el.style.display = 'none';
        });
        if (reset) resetCreatePanel();
    }

    async function createRoom() {
    document.getElementById('btn-do-create').style.display = 'none';
    document.getElementById('create-loading').style.display = 'block';

    try {
        const res = await fetch('/matchmaking/create', { method: 'POST' });
        const data = await res.json();

        if (!data.success) {
            alert(data.error || 'Chyba při vytváření místnosti');
            resetCreatePanel();
            return;
        }

        window._currentRoomId = data.room.id;

        document.getElementById('room-code-text').textContent = data.room.code;
        document.getElementById('create-loading').style.display = 'none';
        document.getElementById('create-result').style.display = 'block';
    } catch (err) {
        alert('Chyba spojení se serverem');
        resetCreatePanel();
    }
}

    function resetCreatePanel() {
        document.getElementById('btn-do-create').style.display = 'block';
        document.getElementById('create-loading').style.display = 'none';
        document.getElementById('create-result').style.display = 'none';
        const tog = document.getElementById('toggle-public');
        if (tog) tog.checked = false;
        const vis = document.getElementById('visibility-status');
        if (vis) vis.textContent = 'privátní';
    }

    async function toggleVisibility() {
    const isPublic = document.getElementById('toggle-public').checked;
    document.getElementById('visibility-status').textContent = isPublic ? 'veřejná' : 'privátní';

    if (!window._currentRoomId) return;

    try {
        await fetch('/matchmaking/room/visibility', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roomId: window._currentRoomId, isPublic })
        });
    } catch (err) {
        console.error('Nepodařilo se změnit viditelnost:', err);
    }
}

    function copyCode() {
        const code = document.getElementById('room-code-text').textContent;
        navigator.clipboard.writeText(code).then(() => {
            const btn = document.querySelector('.btn-copy');
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3498db" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
            setTimeout(() => {
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#667889" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
            }, 1500);
        });
    }

    async function joinRoom() {
    const code = document.getElementById('join-code-input').value.trim();
    document.getElementById('join-error').style.display = 'none';

    if (code.length < 4) {
        document.getElementById('join-error').style.display = 'block';
        return;
    }

    try {
        const res = await fetch(`/matchmaking/join/${code}`, { method: 'POST' });
        const data = await res.json();

        if (!data.success) {
            document.getElementById('join-error').textContent = data.error || 'Místnost nenalezena nebo je plná.';
            document.getElementById('join-error').style.display = 'block';
         return;
        }

        alert(`Úspěšně připojeno k místnosti s kódem ${code}! Přesměrování do hry bude brzy...`);
        } catch (err) {
            document.getElementById('join-error').textContent = 'Chyba spojení se serverem.';
            document.getElementById('join-error').style.display = 'block';
        }
    }

    function findPublicRoom() {
        showPanel('random');
        // TODO: GET /matchmaking/public
    }

</script>

<%- include('../partials/footer') %>