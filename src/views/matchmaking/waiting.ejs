<%- include('../partials/header') %>

<div class="container">
    <div class="lobby-wrapper">
        <h1>Čekám na hru</h1>
        <div class="lobby-panel" style="max-width: 420px; margin: 2rem auto; display: block;">
            <div style="text-align: center; padding: 1rem 0;">

                <div style="margin-bottom: 1rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#cf763b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                </div>

                <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">
                    Připojil ses do místnosti
                </p>
                <div class="room-code-display" style="justify-content: center; margin: 1rem 0;">
                    <span id="room-code-text" style="font-size: 1.8rem; font-family: monospace; letter-spacing: 0.15em; color: #cf763b;">
                        <%= roomCode %>
                    </span>
                </div>
                <p style="color: #7a665d; margin-bottom: 1rem;">
                    Cílové skóre: <strong><%= targetScore %></strong>
                </p>
                <p id="status-text" style="color: #7a665d; margin-bottom: 1.5rem;">
                    Čekám až tvůrce místnosti spustí hru…
                </p>
                <div id="spinner" style="margin: 1rem auto; width: 32px; height: 32px; border: 4px solid #e8ddd0; border-top-color: #cf763b; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>

                <button class="btn-secondary" style="margin-top: 1.5rem;" onclick="window.location.href='/matchmaking/lobby'">
                    Zrušit
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

<script>
    const ROOM_CODE = '<%= roomCode %>';
    let _pollInterval = null;

    function startPolling() {
        _pollInterval = setInterval(pollWaitStatus, 1000);
    }

    function stopPolling() {
        if (_pollInterval) {
            clearInterval(_pollInterval);
            _pollInterval = null;
        }
    }

    async function pollWaitStatus() {
        try {
            const res  = await fetch(`/matchmaking/wait-status/${ROOM_CODE}`);
            const data = await res.json();

            if (!data.success) return;

            if (data.status === 'IN_GAME' && data.gameId) {
                stopPolling();
                document.getElementById('status-text').textContent = 'Hra začíná…';
                document.getElementById('spinner').style.borderTopColor = '#8d8638';
                window.location.href = `/game/multiplayer/${data.gameId}`;
            }
        } catch (err) {
            console.error('pollWaitStatus error:', err);
        }
    }
    startPolling();
</script>

<%- include('../partials/footer') %>