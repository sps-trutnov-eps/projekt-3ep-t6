<%- include('../partials/header') %>

<div class="container">
    <div class="matchmaking-wrapper">
        <h1>Matchmaking</h1>
        <p class="subtitle">Vyber si herní mód</p>
        
        <div class="game-modes">
            <div class="mode-card" onclick="selectMode('solo')">
                <div class="mode-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#667889" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                    </svg>
                </div>
                <h2>Solo</h2>
                <p>Hraj sám proti počítači</p>
                <div class="mode-settings" onclick="event.stopPropagation()">
                    <label for="solo-target-score">Cílové skóre:</label>
                    <input type="number" id="solo-target-score" value="3000" min="500" step="500" class="score-input-mini">
                </div>
            </div>
            
            <div class="mode-card" onclick="selectMode('multi')">
                <div class="mode-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#667889" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="8" r="3.5"/>
                        <path d="M2 20c0-3.5 3.1-6 7-6s7 2.5 7 6"/>
                        <circle cx="17" cy="7" r="3"/>
                        <path d="M22 20c0-3-2.7-5-6-5"/>
                    </svg>
                </div>
                <h2>Multiplayer</h2>
                <p>Hraj s přáteli nebo ostatními hráči</p>
            </div>
        </div>
    </div>
</div>

<style>
    .mode-settings {
        margin-top: 1rem;
        padding-top: 0.5rem;
        border-top: 1px solid #e8ddd0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }
    .score-input-mini {
        width: 100px;
        padding: 5px;
        border: 1px solid #c8bdb0;
        border-radius: 4px;
        text-align: center;
        font-family: 'MedievalSharp', serif;
        background: #fdfaf6;
    }
</style>

<script>
    function selectMode(mode) {
        if (mode === 'solo') {
            const targetScore = document.getElementById('solo-target-score').value;
            const params = { targetScore };
            const options = {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify( params )  
            };

            fetch( '/game/singleplayer/new', options )
                .then( response => response.json() )
                .then( response => {
                    if ( response.success ) {
                        window.location.href = '/game/singleplayer';
                    } else {
                        alert('Nepodařilo se vytvořit novou hru. Zkuste to znovu.');
                    }
                }
            );

        } else if (mode === 'multi') {
            window.location.href = '/matchmaking/lobby';
        }
    }
</script>

<%- include('../partials/footer') %>