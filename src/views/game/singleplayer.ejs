<%- include('../partials/header') %>

<span style="display:none;" id="player-id"><%= user ? user.id : '' %></span>
<span id="dice-left-count" style="display:none;">6</span>
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/gl-matrix/2.8.1/gl-matrix-min.js"
  integrity="sha512-zhHQR0/H5SEBL3Wn6yYSaTTZej12z0hVZKOv3TwCUXT1z5qeqGcXJLLrbERYRScEDDpYIJhPC1fk31gqR783iQ=="
  crossorigin="anonymous"
  defer></script>
<script src="/kostky/renderer.js" type="module"></script>
<script src="/js/game/singleplayer.js" defer></script>

<style>
  .game-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }

  /* Header: title + opponent + goal */
  .game-header {
    text-align: center;
    margin-bottom: 1rem;
  }
  .game-header h1 { margin-bottom: 0.25rem; }
  .game-header .game-meta {
    font-size: 0.95rem;
    color: #2c3e50;
  }

  /* Middle row: canvas centered, side panel offset to the right */
  .game-middle {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* Anchor for canvas + side panel positioning */
  .canvas-anchor {
    position: relative;
    width: 100%;
    max-width: 700px;
  }

  /* Canvas wrapper */
  #dice-3d-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    min-height: 350px;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }
  #cnv {
    width: 100%; height: 100%; display: block;
    image-rendering: pixelated; image-rendering: crisp-edges;
  }

  /* Dice label overlay */
  #dice-overlay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none; overflow: hidden;
  }
  .dice-label {
    position: absolute; transform: translate(-50%, -50%);
    pointer-events: auto; cursor: pointer; user-select: none;
    width: 48px; height: 48px; display: none; border-radius: 50%;
  }
  .dice-label.visible { display: block; }
  .dice-label .dice-value {
    position: absolute; bottom: 100%; left: 50%;
    transform: translateX(-50%);
    font-size: 22px; font-weight: bold; color: #fff;
    text-shadow: 0 0 6px rgba(0,0,0,0.9), 0 2px 4px rgba(0,0,0,0.7);
    padding: 2px 10px; border-radius: 4px; white-space: nowrap;
    opacity: 0; transition: opacity 0.15s; pointer-events: none;
  }
  .dice-label:hover .dice-value,
  .dice-label.selected .dice-value,
  .dice-label.kept .dice-value { opacity: 1; }
  .dice-label:hover .dice-value {
    color: #f0c040;
    text-shadow: 0 0 12px rgba(240,192,64,0.6), 0 0 4px rgba(0,0,0,0.9);
  }
  .dice-label.selected .dice-value {
    color: #f0c040; background: rgba(240,192,64,0.15);
    text-shadow: 0 0 16px rgba(240,192,64,0.8);
  }
  .dice-label.kept .dice-value {
    color: #6c6; text-shadow: 0 0 12px rgba(68,170,68,0.6);
  }
  .dice-label.kept { cursor: default; }

  /* Buttons centered below canvas */
  .game-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 1rem;
  }

  /* Finished banner */
  #game-finished {
    text-align: center;
    margin-bottom: 1rem;
  }

  @media (max-width: 700px) {
    .game-side-panel {
      position: static;
      min-width: unset;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 1rem;
    }
    .game-middle { flex-direction: column; align-items: center; }
  }
</style>

<div class="game-page">

    <div class="game-header">
        <h1><%= message %></h1>
        <div class="game-meta">
            Proti: <span id="opponent-name">Chudému starci</span>
            &middot; Cíl: <span id="target-score">3000</span>
        </div>
    </div>

    <div id="game-finished" style="display: none;">
        <div class="finished-banner">
            <p>Vyhráli jste! Gratulujeme!</p>
        </div>
        <form action="#" method="POST" style="margin-top: 1rem;" onsubmit="startNewSingleplayerGame(event)">
            <button type="submit" class="btn-primary">Začít novou hru</button>
        </form>
    </div>

    <div class="game-middle">
        <div class="canvas-anchor">
            <div id="dice-3d-wrap">
                <div id="canvas-user-score-overlay" style="position: absolute; top: 12px; left: 14px; color: #fff; font-size: 1.3rem; font-weight: bold; text-shadow: 0 2px 6px rgba(0,0,0,0.8), 0 0 2px rgba(0,0,0,0.6); pointer-events: none; z-index: 2; display: flex; flex-direction: column; align-items: flex-start;">
                    <span id="player-score">0</span>
                    <div style="font-size: 1.1rem; color: #f0c040; margin-top: 4px; display: flex; align-items: center;">
                        <span id="turn-score">0</span>
                        <span id="selection-score-row" style="display:none; margin-left: 8px;">+ <span id="selection-score">0</span></span>
                    </div>
                </div>

                <div id="canvas-center-overlay" style="position: absolute; top: 4px; left: 50%; transform: translateX(-50%); color: #fff; font-weight: bold; text-shadow: 0 2px 6px rgba(0,0,0,0.8), 0 0 2px rgba(0,0,0,0.6); pointer-events: none; z-index: 2; display: flex; flex-direction: column; align-items: center;">
                    <p id="turn-indicator" style="font-size: 1rem; margin: 0; display: none;"></p>
                    <div id="bust-msg" style="display:none; font-size: 3rem; color: #ff4444; margin-top: 8px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase;">
                        FARKLE!
                    </div>
                </div>

                <div id="canvas-enemy-score-overlay" style="position: absolute; top: 12px; right: 14px; color: #fff; font-size: 1.3rem; font-weight: bold; text-shadow: 0 2px 6px rgba(0,0,0,0.8), 0 0 2px rgba(0,0,0,0.6); pointer-events: none; z-index: 2; display: flex; flex-direction: column; align-items: flex-end;">
                    <span id="opponent-score">0</span>
                    <div id="enemy-turn-score-flash" style="font-size: 1.1rem; color: #f0c040; margin-top: 4px; opacity: 0; transition: opacity 0.3s; font-weight: bold;">
                        + <span id="enemy-turn-score-value">0</span>
                    </div>
                </div>
                
                <canvas id="cnv" width="640" height="480"></canvas>
                <div id="dice-overlay">
                    <div class="dice-label" data-index="0"><span class="dice-value"></span></div>
                    <div class="dice-label" data-index="1"><span class="dice-value"></span></div>
                    <div class="dice-label" data-index="2"><span class="dice-value"></span></div>
                    <div class="dice-label" data-index="3"><span class="dice-value"></span></div>
                    <div class="dice-label" data-index="4"><span class="dice-value"></span></div>
                    <div class="dice-label" data-index="5"><span class="dice-value"></span></div>
                </div>
            </div>
        </div>
    </div>

    <div id="action-area" class="game-actions">
        <button id="btn-roll"    class="btn-primary"   onclick="rollDice()">Hodit kostkami</button>
        <button id="btn-confirm" class="btn-primary"   onclick="confirmSelection()" style="display:none;" disabled>Potvrdit výběr</button>
        <button id="btn-reroll"  class="btn-secondary" onclick="rerollDice()"       style="display:none;">Hodit znovu</button>
        <button id="btn-bank"    class="btn-secondary" onclick="bankPoints()"        style="display:none;">Bankovat</button>
    </div>

</div>

<%- include('../partials/footer') %>
