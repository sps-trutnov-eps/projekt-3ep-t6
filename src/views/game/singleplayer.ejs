<%- include('../partials/header') %>

<span style="display:none;" id="player-id"><%= user.id %></span>
<script src="/js/game/singleplayer.js" defer></script>

<div class="container">
    <div class="game-wrapper">
        <h1><%= message %></h1>

        <button class="refresh" onclick="getGameState()">Aktualizovat stav hry</button>

        <div id="game-finished" style="display: none;">
            <form action="/game/singleplayer/new" method="POST" style="margin-bottom: 2rem;">
                <button type="submit" class="btn-primary">Začít novou hru</button>
            </form>
        </div>

        <div class="game-state">
            <p>Hrajete proti: <span id="opponent-name"></span></p>
            <p>Vaše celkové skóre: <span id="player-score"></span></p>
            <p>Celkové skóre soupeře: <span id="opponent-score"></span></p>
            <p>V tomto kole jste naházeli: <span id="current-roll"></span></p>
            <button id="roll-dice" class="btn-primary" onclick="rollDice()">Hodit kostkami</button>
        </div>

        <div class="game-board">
            <p>Kostky: <span id="dice"></span></p>
            <p>Body na stole: <span id="turn-score"></span></p>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>