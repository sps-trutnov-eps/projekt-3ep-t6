<%- include('../partials/header') %>

<span style="display:none;" id="player-id"><%= user ? user.id : '' %></span>
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/gl-matrix/2.8.1/gl-matrix-min.js"
  integrity="sha512-zhHQR0/H5SEBL3Wn6yYSaTTZej12z0hVZKOv3TwCUXT1z5qeqGcXJLLrbERYRScEDDpYIJhPC1fk31gqR783iQ=="
  crossorigin="anonymous"
  defer></script>
<script src="/kostky/renderer.js" type="module"></script>
<script src="/js/game/singleplayer.js" defer></script>

<style>
  /* 3D canvas replaces the old 2D dice area */
  #dice-3d-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    min-height: 350px;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }
  #cnv {
    width: 100%; height: 100%; display: block;
    image-rendering: pixelated; image-rendering: crisp-edges;
  }
  #dice-overlay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none; overflow: hidden;
  }
  .dice-label {
    position: absolute; transform: translate(-50%, -50%);
    pointer-events: auto; cursor: pointer; user-select: none;
    width: 48px; height: 48px; display: none; border-radius: 50%;
  }
  .dice-label.visible { display: block; }
  .dice-label .dice-value {
    position: absolute; bottom: 100%; left: 50%;
    transform: translateX(-50%);
    font-size: 22px; font-weight: bold; color: #fff;
    text-shadow: 0 0 6px rgba(0,0,0,0.9), 0 2px 4px rgba(0,0,0,0.7);
    padding: 2px 10px; border-radius: 4px; white-space: nowrap;
    opacity: 0; transition: opacity 0.15s; pointer-events: none;
  }
  .dice-label:hover .dice-value,
  .dice-label.selected .dice-value,
  .dice-label.kept .dice-value { opacity: 1; }
  .dice-label:hover .dice-value {
    color: #f0c040;
    text-shadow: 0 0 12px rgba(240,192,64,0.6), 0 0 4px rgba(0,0,0,0.9);
  }
  .dice-label.selected .dice-value {
    color: #f0c040; background: rgba(240,192,64,0.15);
    text-shadow: 0 0 16px rgba(240,192,64,0.8);
  }
  .dice-label.kept .dice-value {
    color: #6c6; text-shadow: 0 0 12px rgba(68,170,68,0.6);
  }
  .dice-label.kept { cursor: default; }
</style>

<div class="container">
    <div class="game-wrapper">
        <h1><%= message %></h1>

        <div id="game-finished" style="display: none;">
            <div class="finished-banner">
                <p>Vyhrali jste! Gratulujeme!</p>
            </div>
            <form action="/game/singleplayer/new" method="POST" style="margin-top: 1rem;">
                <button type="submit" class="btn-primary">Novou hru</button>
            </form>
        </div>

        <div class="game-layout">

            <!-- Left column: info + actions -->
            <div class="game-left">
                <div class="game-state">
                    <p>Hrajete proti: <span id="opponent-name">Chudemu starci</span></p>
                    <p>Celkove skore: <span id="player-score">0</span></p>
                    <p>Cil: <span>10 000</span></p>
                </div>

                <div class="game-board">
                    <p>Body na stole: <span id="turn-score">0</span></p>

                    <div id="selection-score-row" class="score-row" style="display:none;">
                        <span>Body za vyber:</span>
                        <span id="selection-score" class="score-highlight">0</span>
                    </div>

                    <div id="bust-msg" class="bust-message" style="display:none;">
                        Farkle! Prisel jsi o body v tomto kole.
                    </div>
                </div>

                <div id="action-area" class="action-area">
                    <button id="btn-roll"    class="btn-primary"   onclick="rollDice()">Hodit kostkami</button>
                    <button id="btn-confirm" class="btn-primary"   onclick="confirmSelection()" style="display:none;" disabled>Potvrdit vyber</button>
                    <button id="btn-reroll"  class="btn-secondary" onclick="rerollDice()"       style="display:none;">Hodit znovu</button>
                    <button id="btn-bank"    class="btn-secondary" onclick="bankPoints()"        style="display:none;">Bankovat</button>
                </div>
            </div>

            <!-- Right column: 3D dice canvas -->
            <div class="game-right">
                <div class="game-board">
                    <p>Zbyvajici kostky: <span id="dice-left-count">6</span></p>
                    <div id="dice-3d-wrap">
                        <canvas id="cnv" width="640" height="480"></canvas>
                        <div id="dice-overlay">
                            <div class="dice-label" data-index="0"><span class="dice-value"></span></div>
                            <div class="dice-label" data-index="1"><span class="dice-value"></span></div>
                            <div class="dice-label" data-index="2"><span class="dice-value"></span></div>
                            <div class="dice-label" data-index="3"><span class="dice-value"></span></div>
                            <div class="dice-label" data-index="4"><span class="dice-value"></span></div>
                            <div class="dice-label" data-index="5"><span class="dice-value"></span></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>
